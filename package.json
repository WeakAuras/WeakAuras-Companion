{
  "name": "weakauras-companion",
  "version": "5.3.1",
  "description": "WeakAuras Companion App",
  "keywords": [
    "WeakAuras",
    "World of Warcraft",
    "electron",
    "rollup",
    "vite",
    "vue",
    "vue3"
  ],
  "license": "GPL-2.0-or-later",
  "author": "Buds <mrbouyou@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/WeakAuras/WeakAuras-Companion.git"
  },
  "type": "module",
  "main": "dist-electron/main/index.mjs",
  "scripts": {
    "build": "vue-tsc && vp build && electron-builder",
    "clean": "git clean -xdf node_modules dist dist-electron",
    "compile-tools": "tsc -p tools",
    "dev": "vp dev",
    "i18n": "pnpm run compile-tools && node ./tools/scripts/extract-i18n-messages.js",
    "i18n-report": "pnpm dlx vue-i18n-extract report --add --remove --separator 'buggy' --vueFiles './src/**/*.?(ts|vue)' --languageFiles './i18n/*.json'",
    "postinstall": "install-electron",
    "lint": "vp lint ./src && vp fmt . --check",
    "lint:fix": "vp lint ./src --fix && vp fmt .",
    "prepare": "vp config --no-agent",
    "test": "vp test run",
    "test:ui": "vp test --ui"
  },
  "dependencies": {
    "archiver": "catalog:",
    "archiver-utils": "catalog:",
    "regedit": "catalog:",
    "sharp": "catalog:",
    "tga": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/fa6-brands": "catalog:",
    "@iconify-json/mdi": "catalog:",
    "@iconify/tools": "catalog:",
    "@iconify/utils": "catalog:",
    "@intlify/unplugin-vue-i18n": "catalog:",
    "@types/archiver": "catalog:",
    "@types/luaparse": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@types/tail": "catalog:",
    "@unocss/preset-icons": "catalog:",
    "@unocss/preset-web-fonts": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/ui": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-log": "catalog:",
    "electron-store": "catalog:",
    "electron-updater": "catalog:",
    "floating-vue": "catalog:",
    "glob": "catalog:",
    "got": "catalog:",
    "happy-dom": "catalog:",
    "luaparse": "catalog:",
    "luxon": "catalog:",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate-2": "catalog:",
    "playwright": "catalog:",
    "tail": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-electron": "catalog:",
    "vite-plugin-electron-renderer": "catalog:",
    "vite-plugin-resolve": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vite-plugin-webfont-dl": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-vue": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-tsc": "catalog:"
  },
  "config": {
    "default-locale": "en",
    "supported-locales": [
      "en",
      "es",
      "de",
      "fr",
      "ru",
      "tr",
      "zh-cn"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2",
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  }
}
